# Required. Server-side only -- never exposed to the browser.
OPENAI_API_KEY=sk-proj-...

# Optional overrides.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin

# Optional. Routes YouTube requests through a proxy, for deployments whose
# egress IPs YouTube refuses. The target URL is appended percent-encoded, so
# the value must end at the point where that URL belongs.
# YOUTUBE_PROXY_URL=https://proxy.example.com/?url=
